# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenAI-compatible endpoint) ---
# Hackathon: Groq. Closed network: point at Ollama, e.g.
#   LLM_BASE_URL=http://ollama:11434/v1  LLM_API_KEY=ollama
#   MODEL_FAST=gpt-oss:20b  MODEL_SMART=gpt-oss:20b   (~16 GB GPU)
# Groq free-tier limits are per model (about 8K tokens/min each), so the defaults put
# triage and investigation on different models.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
MODEL_FAST=qwen/qwen3.8-27b
MODEL_SMART=openai/gpt-oss-20b
# gpt-oss only (other models never get it): low | medium | high. Low saves tokens.
LLM_REASONING_EFFORT=low

# --- Git (gitops-manifests repo) ---
GITOPS_REPO=RaniGiterman/devon-gitops
# Token with contents + pull_requests write on GITOPS_REPO.
GITHUB_TOKEN=

# --- Telegram (leave empty to use the web approval page on the scoreboard) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Who may press Approve / Reject: comma-separated @usernames and/or numeric user IDs.
# IDs are safer (usernames can change). Empty = anyone in the chat.
TELEGRAM_APPROVERS=

# --- Cluster / behaviour ---
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
AGENT_PORT=8088
# Seconds a fix must stay healthy before the incident is resolved (3 min real, ~45s on stage).
VERIFY_WINDOW_S=180
